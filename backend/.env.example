# =================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# Copy this to .env and update with your actual values
# =================================================================

# Application Settings
APP_NAME="Camilo AI Analytics Backend"
VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL="postgresql+asyncpg://username:password@hostname:port/database?sslmode=require"

# Redis Configuration (for rate limiting and caching)
REDIS_URL="redis://localhost:6379"

# OpenAI Configuration
OPENAI_API_KEY="REPLACE_ME"
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Strava API Configuration
STRAVA_CLIENT_ID="REPLACE_ME"
STRAVA_CLIENT_SECRET="REPLACE_ME"
STRAVA_ACCESS_TOKEN="REPLACE_ME"
STRAVA_REFRESH_TOKEN="REPLACE_ME"

# WHOOP API Configuration
WHOOP_CLIENT_ID="REPLACE_ME"
WHOOP_CLIENT_SECRET="REPLACE_ME"

# Security & Authentication
SECRET_KEY="REPLACE_ME"
ADMIN_API_KEY="REPLACE_ME"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_DEFAULT=5
RATE_LIMIT_WINDOW=86400
RATE_LIMIT_BYPASS_SECRET="REPLACE_ME"

# Cron Job Security
CRON_SECRET="REPLACE_ME"

# Frontend Integration
NEXTAUTH_URL="http://localhost:3005"
CORS_ORIGINS=["http://localhost:3005", "https://localhost:3005"]
TRUSTED_HOSTS=["localhost", "127.0.0.1"]

# External Services (optional)
VERCEL_OIDC_TOKEN="REPLACE_ME"
