{
  "crons": [
    {
      "path": "/api/cron/daily-data-fetch?secret=REDACTED_CRON_SECRET",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/strava-weekly-sync?secret=cron_secure_strava_weekly_sync_2024",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/astoria-update?secret=cron_secure_astoria_update_2024",
      "schedule": "30 13 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portfolio-starter-kit-green-beta.vercel.app" }],
      "destination": "https://camilomartinez.co/:path*",
      "permanent": true
    }
  ]
}
