# Social Media Pipeline Environment Variables
# Copy this file to .env and add your actual API keys

# Required: OpenAI API Key for content processing
OPENAI_API_KEY=your_openai_api_key_here

# Optional: DeepL API Key for Spanish translation
# If not provided, only English processing will be available
DEEPL_API_KEY=your_deepl_api_key_here

# Optional Configuration Settings
CHARACTER_THRESHOLD=280
MAX_TOKENS=2000
TEMPERATURE=0.7
TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Development Settings
DEBUG=True
LOG_LEVEL=INFO