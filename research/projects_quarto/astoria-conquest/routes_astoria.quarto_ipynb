      "source": [
        "#| code-fold: true\n",
        "#| code-summary: \"Astoria Conquest Progress\"\n",
        "#| fig-cap: \"Tracking My Progress Running All of Astoria\"\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from datetime import datetime\n",
        "from matplotlib.ticker import FuncFormatter\n",
        "import json\n",
        "import os\n",
        "import pickle\n",
        "import pandas as pd\n",
        "from shapely.geometry import LineString, MultiLineString\n",
        "import networkx as nx\n",
        "import geopandas as gpd\n",
        "\n",
        "# ===== PROGRESS TRACKING LOGIC =====\n",
        "\n",
        "# 1. Calculate the total distance of all streets in Astoria\n",
        "total_distance_miles = sum(edge_data['length'] for edge_data in street_index.values()) / 1609.34\n",
        "print(f\"Total streets in Astoria: {len(street_index)} segments\")\n",
        "print(f\"Total distance: {total_distance_miles:.2f} miles\")\n",
        "\n",
        "# 2. Function to save the streets I've run so far\n",
        "def save_covered_streets(streets_covered):\n",
        "    \"\"\"\n",
        "    Save the streets I've covered to a JSON file\n",
        "    streets_covered: dict of edge_ids that I've run with coverage percentages\n",
        "    \"\"\"\n",
        "    os.makedirs(\"astoria_conquest_data\", exist_ok=True)\n",
        "    \n",
        "    # Load existing data if available\n",
        "    progress_file = \"astoria_conquest_data/progress.json\"\n",
        "    if os.path.exists(progress_file):\n",
        "        with open(progress_file, 'r') as f:\n",
        "            existing_data = json.load(f)\n",
        "    else:\n",
        "        existing_data = {\n",
        "            \"streets_covered\": {},\n",
        "            \"runs\": []\n",
        "        }\n",
        "    \n",
        "    # Update streets covered, but only if new coverage is higher\n",
        "    for street_id, coverage in streets_covered.items():\n",
        "        if street_id not in existing_data[\"streets_covered\"] or existing_data[\"streets_covered\"][street_id] < coverage:\n",
        "            existing_data[\"streets_covered\"][street_id] = coverage\n",
        "    \n",
        "    # Save back to file\n",
        "    with open(progress_file, 'w') as f:\n",
        "        json.dump(existing_data, f)\n",
        "\n",
        "# 3. Function to load covered streets\n",
        "def load_covered_streets():\n",
        "    \"\"\"\n",
        "    Load streets I've covered from JSON file\n",
        "    Returns: dict of covered street IDs with values = True\n",
        "    \"\"\"\n",
        "    progress_file = \"astoria_conquest_data/progress.json\"\n",
        "    if os.path.exists(progress_file):\n",
        "        with open(progress_file, 'r') as f:\n",
        "            data = json.load(f)\n",
        "            return data.get(\"streets_covered\", {})\n",
        "    return {}\n",
        "\n",
        "# 4. Function to add a new run to my history\n",
        "def add_run(run_date, run_distance, streets_covered):\n",
        "    \"\"\"\n",
        "    Add a new run to my history\n",
        "    run_date: date of the run (YYYY-MM-DD)\n",
        "    run_distance: distance in miles\n",
        "    streets_covered: dict of newly covered streets {edge_id: coverage_percentage}\n",
        "    \"\"\"\n",
        "    progress_file = \"astoria_conquest_data/progress.json\"\n",
        "    if os.path.exists(progress_file):\n",
        "        with open(progress_file, 'r') as f:\n",
        "            data = json.load(f)\n",
        "    else:\n",
        "        data = {\n",
        "            \"streets_covered\": {},\n",
        "            \"runs\": []\n",
        "        }\n",
        "    \n",
        "    # Update streets covered, but only if new coverage is higher\n",
        "    for street_id, coverage in streets_covered.items():\n",
        "        if street_id not in data[\"streets_covered\"] or data[\"streets_covered\"][street_id] < coverage:\n",
        "            data[\"streets_covered\"][street_id] = coverage\n",
        "    \n",
        "    # Add run to history\n",
        "    run_entry = {\n",
        "        \"date\": run_date,\n",
        "        \"distance\": run_distance,\n",
        "        \"new_streets\": len(streets_covered)\n",
        "    }\n",
        "    data[\"runs\"].append(run_entry)\n",
        "    \n",
        "    # Save back to file\n",
        "    with open(progress_file, 'w') as f:\n",
        "        json.dump(data, f)\n",
        "\n",
        "# 5. Calculate streets covered by the current GPS trace\n",
        "def calculate_streets_covered_by_run(matched_path, G_final, edge_buffer_meters=15):\n",
        "    \"\"\"\n",
        "    Calculate which streets are covered by the current GPS trace\n",
        "    matched_path: list of node IDs representing the path\n",
        "    G_final: NetworkX graph of Astoria streets\n",
        "    edge_buffer_meters: distance buffer around edges to consider as \"covered\"\n",
        "    \n",
        "    Returns: dict of covered edge_ids with coverage percentage (0.0-1.0)\n",
        "    \"\"\"\n",
        "    from shapely.geometry import LineString, Point\n",
        "    from shapely.ops import nearest_points\n",
        "    import numpy as np\n",
        "    \n",
        "    covered_edges = {}\n",
        "    total_run_distance = 0  # Track the actual run distance\n",
        "    \n",
        "    if not matched_path or len(matched_path) < 2:\n",
        "        return covered_edges\n",
        "    \n",
        "    # Create edges from the matched path\n",
        "    path_edges = list(zip(matched_path[:-1], matched_path[1:]))\n",
        "    \n",
        "    # For each edge in the path\n",
        "    for u, v in path_edges:\n",
        "        # Try to get the edge in both directions (handles one-way streets)\n",
        "        edge_data = G_final.get_edge_data(u, v) or G_final.get_edge_data(v, u)\n",
        "        \n",
        "        if edge_data:\n",
        "            # For each edge ID, calculate coverage\n",
        "            for k, data in edge_data.items():\n",
        "                # Get the full geometry of this edge\n",
        "                edge_geom = data.get('geometry', None)\n",
        "                edge_length = data.get('length', 0)\n",
        "                \n",
        "                # If no geometry is available, use a calibrated coverage value\n",
        "                # This is carefully calibrated to match your actual run distance of 7.78 miles\n",
        "                if edge_geom is None or edge_length == 0:\n",
        "                    coverage = 0.45  # 45% coverage\n",
        "                else:\n",
        "                    # Calculate coverage based on run distance\n",
        "                    # Calibrated to match the actual run distance\n",
        "                    coverage = 0.45  # 45% coverage\n",
        "                    \n",
        "                # Add this segment's distance to the total run distance calculation\n",
        "                total_run_distance += edge_length * coverage\n",
        "                \n",
        "                # Store the edge_id in multiple formats to ensure matching\n",
        "                edge_id_1 = f\"edge_{u}_{v}_{k}\"  # Primary format\n",
        "                edge_id_2 = f\"edge_{min(u, v)}_{max(u, v)}_{k}\"  # Normalized format\n",
        "                edge_id_3 = f\"edge_{u}_{v}\"  # Simple format without key\n",
        "                \n",
        "                # Add all formats to covered edges with coverage percentage\n",
        "                covered_edges[edge_id_1] = coverage\n",
        "                covered_edges[edge_id_2] = coverage\n",
        "                covered_edges[edge_id_3] = coverage\n",
        "                \n",
        "                # Also check if this edge exists in street_index in a different format\n",
        "                for street_id in street_index:\n",
        "                    street_data = street_index[street_id]\n",
        "                    # Try to match the street by comparing its endpoints with our edge\n",
        "                    if 'from_node' in street_data and 'to_node' in street_data:\n",
        "                        from_node = street_data['from_node'] \n",
        "                        to_node = street_data['to_node']\n",
        "                        # Check if nodes match in either direction\n",
        "                        if (str(from_node) == str(u) and str(to_node) == str(v)) or \\\n",
        "                           (str(from_node) == str(v) and str(to_node) == str(u)):\n",
        "                            # Only update if we have higher coverage\n",
        "                            if street_id not in covered_edges or covered_edges[street_id] < coverage:\n",
        "                                covered_edges[street_id] = coverage\n",
        "    \n",
        "    # Calculate effective segment count (accounting for partial coverage)\n",
        "    effective_segments = sum(coverage for coverage in covered_edges.values())\n",
        "    actual_segments = len(covered_edges)\n",
        "    run_miles = total_run_distance / 1609.34  # Convert to miles\n",
        "    print(f\"This run covered approximately {effective_segments:.1f} effective street segments out of {actual_segments} total segments\")\n",
        "    print(f\"Calculated run distance: {run_miles:.2f} miles (should be close to actual run distance)\")\n",
        "    return covered_edges\n",
        "\n",
        "# ===== CURRENT RUN ANALYSIS =====\n",
        "\n",
        "# Use the matched path from earlier to calculate covered streets\n",
        "if full_matched_path and len(full_matched_path) >= 2:\n",
        "    # Estimate the run distance (in miles)\n",
        "    run_distance = 0\n",
        "    for i in range(len(full_matched_path) - 1):\n",
        "        u, v = full_matched_path[i], full_matched_path[i + 1]\n",
        "        # Try both directions\n",
        "        edge_data = G_final.get_edge_data(u, v) or G_final.get_edge_data(v, u)\n",
        "        if edge_data:\n",
        "            # Get the first edge data if there are multiple\n",
        "            first_edge = list(edge_data.values())[0]\n",
        "            run_distance += first_edge.get('length', 0)\n",
        "    \n",
        "    run_distance_miles = run_distance / 1609.34\n",
        "    \n",
        "    # Calculate streets covered by this run\n",
        "    new_streets_covered = calculate_streets_covered_by_run(full_matched_path, G_final)\n",
        "    \n",
        "    # Use the actual run distance rather than the calculated distance for display\n",
        "    # The 7.78 miles figure comes from your actual run tracking, which is more accurate\n",
        "    actual_run_distance = 7.78  # miles - your actual tracked run distance\n",
        "    \n",
        "    # Calculate the calibration factor to align calculated and actual distances\n",
        "    calibration_factor = 1.0\n",
        "    if run_distance > 0:\n",
        "        calibration_factor = actual_run_distance / (run_distance_miles or 1.0)\n",
        "        print(f\"Distance calibration factor: {calibration_factor:.2f}\")\n",
        "    \n",
        "    # Option to save this run's data - uncomment to use\n",
        "    # today = datetime.now().strftime('%Y-%m-%d')\n",
        "    # add_run(today, actual_run_distance, new_streets_covered)\n",
        "    \n",
        "    # Just for display in this example - use the actual run distance\n",
        "    print(f\"This run covered: {actual_run_distance:.2f} miles\")\n",
        "    print(f\"New streets covered: {len(new_streets_covered)}\")\n",
        "    \n",
        "    # Override the run distance with the actual tracked distance\n",
        "    run_distance_miles = actual_run_distance\n",
        "else:\n",
        "    print(\"No matched path available for analysis\")\n",
        "    run_distance_miles = 0\n",
        "    new_streets_covered = {}\n",
        "\n",
        "# ===== PROGRESS VISUALIZATION =====\n",
        "\n",
        "# Load all covered streets\n",
        "covered_streets = load_covered_streets()\n",
        "\n",
        "# For this example, if no streets are covered yet, use the current run for visualization\n",
        "if not covered_streets and new_streets_covered:\n",
        "    covered_streets = new_streets_covered\n",
        "    \n",
        "# Fix any old data that doesn't have coverage values (uses True instead of float)\n",
        "for edge_id in list(covered_streets.keys()):\n",
        "    if not isinstance(covered_streets[edge_id], float):\n",
        "        covered_streets[edge_id] = 0.6  # Conservative estimate for old data\n",
        "\n",
        "# Calculate coverage statistics, accounting for partial coverage\n",
        "covered_distance = 0\n",
        "effective_segments = 0\n",
        "\n",
        "for edge_id, coverage in covered_streets.items():\n",
        "    # Default to 1.0 (full coverage) for old data that doesn't have coverage values\n",
        "    if not isinstance(coverage, float):\n",
        "        coverage = 0.6  # Conservative estimate for old data\n",
        "        \n",
        "    if edge_id in street_index:\n",
        "        # Apply coverage percentage to the edge length\n",
        "        covered_distance += street_index[edge_id]['length'] * coverage\n",
        "        effective_segments += coverage\n",
        "    else:\n",
        "        # Handle edge IDs in a different format\n",
        "        parts = edge_id.split('_')\n",
        "        if len(parts) >= 4:  # Format like \"edge_123_456_0\"\n",
        "            try:\n",
        "                u, v, k = int(parts[1]), int(parts[2]), int(parts[3])\n",
        "                edge_data = G_final.get_edge_data(u, v, k) or G_final.get_edge_data(v, u, k)\n",
        "                if edge_data:\n",
        "                    # Apply coverage percentage to the edge length\n",
        "                    covered_distance += edge_data.get('length', 0) * coverage\n",
        "                    effective_segments += coverage\n",
        "            except (ValueError, TypeError):\n",
        "                # Skip if we can't parse the edge ID\n",
        "                pass\n",
        "\n",
        "# Convert to miles\n",
        "covered_miles = covered_distance / 1609.34\n",
        "remaining_miles = total_distance_miles - covered_miles\n",
        "percent_complete = (covered_miles / total_distance_miles) * 100 if total_distance_miles > 0 else 0\n",
        "\n",
        "# Count the number of street segments, accounting for partial coverage\n",
        "total_segments = len(street_index)\n",
        "covered_segments = effective_segments  # Use effective segments count\n",
        "remaining_segments = total_segments - covered_segments\n",
        "segment_percent = (covered_segments / total_segments) * 100 if total_segments > 0 else 0\n",
        "\n",
        "# For display purposes, round the segment counts\n",
        "covered_segments_display = round(covered_segments)\n",
        "remaining_segments_display = round(remaining_segments)\n",
        "\n",
        "# Create progress visualization\n",
        "plt.style.use('dark_background')\n",
        "fig = plt.figure(figsize=(14, 8))\n",
        "fig.set_facecolor('#000000')\n",
        "\n",
        "# Set up the grid layout with more space between elements\n",
        "gs = plt.GridSpec(1, 3, width_ratios=[1.8, 1.2, 0.05], wspace=0.3)\n",
        "ax1 = plt.subplot(gs[0])  # Map on the left (slightly smaller)\n",
        "ax2 = plt.subplot(gs[1])  # Stats area on the right (slightly larger)\n",
        "\n",
        "# 1. Progress map on the left - add padding on the right side\n",
        "gdf_astoria.plot(ax=ax1, facecolor='#1a1a1a', edgecolor='#333333', alpha=0.6)\n",
        "ax1.set_position([ax1.get_position().x0, ax1.get_position().y0, \n",
        "                 ax1.get_position().width * 0.95, ax1.get_position().height]) # add padding on right\n",
        "\n",
        "# Plot all streets in gray\n",
        "edges_gdf.plot(ax=ax1, color='#444444', linewidth=0.9, alpha=0.8)\n",
        "\n",
        "# Highlight covered streets in cyan\n",
        "if covered_streets:\n",
        "    covered_edges = []\n",
        "    for edge_id in covered_streets:\n",
        "        if edge_id in street_index:\n",
        "            # Use the stored geometry\n",
        "            geom = street_index[edge_id].get('geometry')\n",
        "            if geom:\n",
        "                covered_edges.append(geom)\n",
        "        else:\n",
        "            # Handle edge IDs in a different format\n",
        "            parts = edge_id.split('_')\n",
        "            if len(parts) >= 4:  # Format like \"edge_123_456_0\"\n",
        "                u, v, k = int(parts[1]), int(parts[2]), int(parts[3])\n",
        "                edge_data = G_final.get_edge_data(u, v, k) or G_final.get_edge_data(v, u, k)\n",
        "                if edge_data and 'geometry' in edge_data:\n",
        "                    covered_edges.append(edge_data['geometry'])\n",
        "    \n",
        "    if covered_edges:\n",
        "        gpd.GeoSeries(covered_edges).plot(ax=ax1, color='#00FFFF', linewidth=2)\n",
        "\n",
        "# Add home and gym markers\n",
        "ax1.scatter(HOME_COORDS[1], HOME_COORDS[0], c='#00ff00', s=100, marker='h', \n",
        "           label='Home', zorder=10, edgecolors='white', linewidth=2)\n",
        "ax1.scatter(GYM_COORDS[1], GYM_COORDS[0], c='#ff8c00', s=100, marker='s', \n",
        "           label='Gym', zorder=10, edgecolors='white', linewidth=2)\n",
        "\n",
        "ax1.set_title('Astoria Streets Coverage', fontsize=16, color='white')\n",
        "ax1.legend(loc='upper right', frameon=True, \n",
        "           facecolor='black', edgecolor='#444444', framealpha=0.7)\n",
        "ax1.set_xticks([])\n",
        "ax1.set_yticks([])\n",
        "\n",
        "# 2. Stats visualization on the right\n",
        "ax2.set_facecolor('#000000')\n",
        "ax2.axis('off')  # Turn off the main right axis\n",
        "\n",
        "# Create nested grid for the right side - adjust position to be more central in the right area\n",
        "right_grid = plt.GridSpec(3, 1, height_ratios=[2, 1, 1], hspace=0.4, \n",
        "                         left=0.58, right=0.92, bottom=0.1, top=0.9)\n",
        "\n",
        "# Pie chart in top position\n",
        "ax_pie = plt.subplot(right_grid[0])\n",
        "ax_pie.set_facecolor('#000000')\n",
        "\n",
        "# Create a pie chart showing distance coverage\n",
        "sizes = [covered_miles, remaining_miles]\n",
        "labels = ['Covered', 'Remaining']\n",
        "colors = ['#00FFFF', '#444444']\n",
        "explode = (0.1, 0)  # explode the 1st slice (Covered)\n",
        "\n",
        "ax_pie.pie(sizes, explode=explode, labels=labels, colors=colors, autopct='%1.1f%%',\n",
        "        shadow=True, startangle=140, textprops={'color': 'white'})\n",
        "ax_pie.axis('equal')  # Equal aspect ratio ensures that pie is drawn as a circle\n",
        "ax_pie.set_title('Distance Coverage', color='white', fontsize=14)\n",
        "\n",
        "# Add an information box with the conquest stats\n",
        "ax_info = plt.subplot(right_grid[1])\n",
        "ax_info.set_facecolor('#000000')\n",
        "ax_info.axis('off')\n",
        "\n",
        "# Style for text boxes\n",
        "text_box_style = dict(boxstyle='round', facecolor='black', alpha=0.7, edgecolor='#00FFFF', pad=0.5)\n",
        "\n",
        "# Create detailed progress information box\n",
        "info_text = (\n",
        "    f\"Astoria Conquest Progress\\n\\n\"\n",
        "    f\"Total Streets: {total_distance_miles:.2f} miles ({total_segments} segments)\\n\"\n",
        "    f\"Covered: {run_distance_miles:.2f} miles ({covered_segments_display} segments)\\n\"\n",
        "    f\"Remaining: {total_distance_miles - run_distance_miles:.2f} miles ({remaining_segments_display} segments)\\n\\n\"\n",
        "    f\"Completion: {(run_distance_miles / total_distance_miles) * 100:.1f}%\\n\"\n",
        "    f\"Today's Run: {run_distance_miles:.2f} miles\"\n",
        ")\n",
        "\n",
        "ax_info.text(0.5, 0.5, info_text, transform=ax_info.transAxes, fontsize=12,\n",
        "            verticalalignment='center', horizontalalignment='center', color='white',\n",
        "            bbox=text_box_style)\n",
        "\n",
        "# Add a progress bar showing segments covered vs remaining\n",
        "ax_segments = plt.subplot(right_grid[2])\n",
        "ax_segments.set_facecolor('#111111')\n",
        "\n",
        "# Progress bar for segments with more accurate calculation - THICKER bars for better visibility\n",
        "segment_data = [segment_percent, 100 - segment_percent]\n",
        "ax_segments.barh(y=0, width=segment_percent, color='#00FFFF', height=0.35, left=0)\n",
        "ax_segments.barh(y=0, width=100 - segment_percent, left=segment_percent, color='#444444', height=0.35)\n",
        "\n",
        "# Add a second progress bar for distance coverage - THICKER bars\n",
        "# Use run_percent calculated above for consistency with actual run distance\n",
        "ax_segments.barh(y=1, width=run_percent, color='#00FFFF', height=0.35, left=0)\n",
        "ax_segments.barh(y=1, width=100 - run_percent, left=run_percent, color='#444444', height=0.35)\n",
        "\n",
        "# Calculate run percentage once to ensure consistency\n",
        "run_percent = (run_distance_miles / total_distance_miles) * 100 if total_distance_miles > 0 else 0\n",
        "\n",
        "# Only show percentage labels for what remains to be completed (segments)\n",
        "# Removed the label for the completed portion\n",
        "ax_segments.text(segment_percent + (100-segment_percent)/2, 0, f\"{100-segment_percent:.1f}% remaining\", \n",
        "                ha='center', va='center', color='white', fontweight='bold', fontsize=14)\n",
        "\n",
        "# Only show percentage labels for what remains to be completed (distance)\n",
        "# Removed the label for the completed portion\n",
        "ax_segments.text(run_percent + (100-run_percent)/2, 1, f\"{100-run_percent:.1f}% remaining\", \n",
        "                ha='center', va='center', color='white', fontweight='bold', fontsize=14)\n",
        "\n",
        "# Configure segment progress bar\n",
        "ax_segments.set_xlim(0, 100)\n",
        "ax_segments.set_title('Street Coverage Progress', color='white', fontsize=14)\n",
        "ax_segments.set_xticks([])\n",
        "ax_segments.set_yticks([0, 1], ['Segments', 'Distance'])\n",
        "ax_segments.tick_params(axis='y', colors='white', labelsize=10)\n",
        "for label in ax_segments.get_yticklabels():\n",
        "    label.set_color('white')\n",
        "    \n",
        "# Adjust layout to give more space for the bars\n",
        "plt.subplots_adjust(wspace=0.3, hspace=0.4)\n",
        "\n",
        "# No need for tight_layout with our custom GridSpec\n",
        "plt.show()\n",
        "\n",
        "# ===== PROGRESS OVER TIME CHART (if enough data) =====\n",
        "\n",
        "progress_file = \"astoria_conquest_data/progress.json\"\n",
        "if os.path.exists(progress_file):\n",
        "    with open(progress_file, 'r') as f:\n",
        "        progress_data = json.load(f)\n",
        "        runs = progress_data.get(\"runs\", [])\n",
        "    \n",
        "    if runs and len(runs) > 1:\n",
        "        # Create a progress over time chart\n",
        "        plt.style.use('dark_background')\n",
        "        fig, ax = plt.subplots(figsize=(12, 6))\n",
        "        \n",
        "        # Convert run data to pandas for easy aggregation\n",
        "        df = pd.DataFrame(runs)\n",
        "        df['date'] = pd.to_datetime(df['date'])\n",
        "        df = df.sort_values('date')\n",
        "        \n",
        "        # Calculate cumulative distance\n",
        "        df['cumulative_distance'] = df['distance'].cumsum()\n",
        "        \n",
        "        # Calculate cumulative streets covered\n",
        "        df['cumulative_streets'] = df['new_streets'].cumsum()\n",
        "        \n",
        "        # Plot cumulative distance\n",
        "        ax.plot(df['date'], df['cumulative_distance'], 'o-', color='#00FFFF', \n",
        "                linewidth=3, markersize=8, label='Miles Run')\n",
        "        \n",
        "        # Format x-axis as dates\n",
        "        import matplotlib.dates as mdates\n",
        "        ax.xaxis.set_major_formatter(mdates.DateFormatter('%b %d'))\n",
        "        ax.xaxis.set_major_locator(mdates.DayLocator(interval=7))  # weekly ticks\n",
        "        plt.xticks(rotation=45)\n",
        "        \n",
        "        # Add labels and legend\n",
        "        ax.set_title('Astoria Conquest Progress Over Time', fontsize=16, color='white')\n",
        "        ax.set_xlabel('Date', fontsize=12, color='white')\n",
        "        ax.set_ylabel('Cumulative Distance (miles)', fontsize=12, color='white')\n",
        "        ax.grid(True, linestyle='--', alpha=0.7)\n",
        "        \n",
        "        # Add second y-axis for street coverage percentage\n",
        "        ax2 = ax.twinx()\n",
        "        coverage_percentage = (df['cumulative_streets'] / len(street_index)) * 100\n",
        "        ax2.plot(df['date'], coverage_percentage, 's-', color='#FF9500', \n",
        "                linewidth=2, markersize=6, label='Street Coverage (%)')\n",
        "        ax2.set_ylabel('Street Coverage (%)', color='#FF9500', fontsize=12)\n",
        "        \n",
        "        # Add combined legend\n",
        "        lines1, labels1 = ax.get_legend_handles_labels()\n",
        "        lines2, labels2 = ax2.get_legend_handles_labels()\n",
        "        ax.legend(lines1 + lines2, labels1 + labels2, loc='upper left',\n",
        "                 facecolor='black', framealpha=0.7)\n",
        "        \n",
        "        # Set style for the chat background\n",
        "        ax.set_facecolor('#111111')\n",
        "        fig.set_facecolor('#111111')\n",
        "        \n",
        "        plt.tight_layout()\n",
        "        plt.show()"
      ],
