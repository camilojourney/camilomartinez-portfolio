    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "#| code-summary: \"Show Code\"\n",
        "#| fig-cap: \"Astoria Street Network Map\"\n",
        "#!/usr/bin/env python3\n",
        "\"\"\"\n",
        "Generate Astoria Street Network Map and Street Index\n",
        "\n",
        "This script creates a visualization of the Astoria street network and\n",
        "builds an index of streets for future polyline matching.\n",
        "\"\"\"\n",
        "\n",
        "import json\n",
        "import requests\n",
        "import pandas as pd\n",
        "import geopandas as gpd\n",
        "import osmnx as ox\n",
        "import networkx as nx\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from shapely.geometry import shape\n",
        "from shapely.ops import unary_union\n",
        "import time\n",
        "import os\n",
        "import pickle\n",
        "\n",
        "print(\"🗺️ Exporting Astoria Street Network for Web Application...\")\n",
        "\n",
        "# Step 1: Get Astoria neighborhoods (same as in Quarto project)\n",
        "print(\"📍 Fetching Astoria neighborhood boundaries...\")\n",
        "API_URL = \"https://data.cityofnewyork.us/resource/9nt8-h7nd.json\"\n",
        "params = {\"$where\": \"upper(ntaname) like '%ASTORIA%'\"}\n",
        "\n",
        "response = requests.get(API_URL, params=params)\n",
        "response.raise_for_status()\n",
        "df = pd.DataFrame(response.json())\n",
        "\n",
        "# Filter for null geometry\n",
        "df = df[~df['the_geom'].isnull()].copy()\n",
        "\n",
        "# Parse geometry safely\n",
        "def parse_geojson_geom(geom_dict):\n",
        "    try:\n",
        "        if isinstance(geom_dict, dict) and 'type' in geom_dict:\n",
        "            return shape(geom_dict)\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"⚠️ Failed to parse geometry: {str(e)[:100]}...\")\n",
        "        return None\n",
        "\n",
        "geometry_series = df['the_geom'].apply(parse_geojson_geom)\n",
        "valid_geom = geometry_series.notna()\n",
        "df = df[valid_geom].copy()\n",
        "geometry_series = geometry_series[valid_geom]\n",
        "\n",
        "# Create GeoDataFrame\n",
        "gdf = gpd.GeoDataFrame(df, geometry=geometry_series, crs=\"EPSG:4326\")\n",
        "\n",
        "# Filter for specific Astoria neighborhoods (same as Quarto project)\n",
        "keep_names = {\n",
        "    \"Astoria (Central)\",\n",
        "    \"Old Astoria-Hallets Point\", \n",
        "    'Astoria (East)-Woodside (North)',\n",
        "    'Queensbridge-Ravenswood-Dutch Kills',\n",
        "    'Astoria (North)-Ditmars-Steinway',\n",
        "    'Astoria Park'\n",
        "}\n",
        "\n",
        "keep_names_normalized = {name.lower().strip() for name in keep_names}\n",
        "gdf['ntaname_normalized'] = gdf['ntaname'].str.lower().str.strip()\n",
        "gdf_astoria = gdf[gdf[\"ntaname_normalized\"].isin(keep_names_normalized)].copy()\n",
        "\n",
        "print(f\"📊 Selected {len(gdf_astoria)} Astoria neighborhoods\")\n",
        "\n",
        "# Step 2: Download street network (same parameters as Quarto project)\n",
        "print(\"🛣️ Downloading street network from OpenStreetMap...\")\n",
        "start_time = time.time()\n",
        "\n",
        "astoria_boundary = unary_union(gdf_astoria.geometry.values)\n",
        "\n",
        "# Download with same parameters as Quarto project\n",
        "G = ox.graph_from_polygon(\n",
        "    astoria_boundary, \n",
        "    network_type='walk',\n",
        "    retain_all=True,\n",
        "    truncate_by_edge=True\n",
        ")\n",
        "\n",
        "# Filter for running-suitable street types (same as Quarto project)\n",
        "def remove_all_dead_ends(graph):\n",
        "    G_pruned = graph.copy()\n",
        "    while True:\n",
        "        dead_ends = [\n",
        "            node for node in G_pruned.nodes()\n",
        "            if len(set(G_pruned.successors(node)) | set(G_pruned.predecessors(node))) == 1\n",
        "        ]\n",
        "        if not dead_ends:\n",
        "            break\n",
        "        G_pruned.remove_nodes_from(dead_ends)\n",
        "    \n",
        "    if G_pruned.number_of_nodes() > 0:\n",
        "        import networkx as nx\n",
        "        largest_component = max(nx.weakly_connected_components(G_pruned), key=len)\n",
        "        G_final = G_pruned.subgraph(largest_component).copy()\n",
        "    else:\n",
        "        G_final = G_pruned\n",
        "    return G_final\n",
        "\n",
        "# Filter street types (same as Quarto project)\n",
        "street_types_to_keep = ['residential', 'tertiary', 'secondary', 'unclassified', 'living_street']\n",
        "G_filtered = ox.graph_from_polygon(\n",
        "    astoria_boundary,\n",
        "    network_type='walk',\n",
        "    custom_filter=f'[\"highway\"~\"{\"|\".join(street_types_to_keep)}\"]'\n",
        ")\n",
        "\n",
        "# Remove dead ends (same as Quarto project)\n",
        "G_final = remove_all_dead_ends(G_filtered)\n",
        "\n",
        "download_time = time.time() - start_time\n",
        "print(f\"✅ Network downloaded in {download_time:.1f}s\")\n",
        "\n",
        "# Step 3: Convert to GeoDataFrames\n",
        "nodes_gdf, edges_gdf = ox.graph_to_gdfs(G_final)\n",
        "\n",
        "print(f\"📊 Network Statistics:\")\n",
        "print(f\"   • Nodes (intersections): {len(nodes_gdf):,}\")\n",
        "print(f\"   • Edges (street segments): {len(edges_gdf):,}\")\n",
        "print(f\"   • Total length: {(edges_gdf['length'].sum() / 1609.34):.1f} miles\")\n",
        "\n",
        "# Step 4: Create optimized data structure for web application  \n",
        "print(\"⚡ Creating optimized data structure...\")\n",
        "\n",
        "# Create spatial grid for fast lookups (divide area into grid cells)\n",
        "bounds = edges_gdf.total_bounds  # minx, miny, maxx, maxy\n",
        "GRID_SIZE = 20  # 20x20 grid for spatial indexing\n",
        "\n",
        "# Define home and gym coordinates (consistent with the rest of the project)\n",
        "HOME_COORDS = (40.755124137014725, -73.92649719348772)  # (lat, lng)\n",
        "GYM_COORDS = (40.762049034238565, -73.92476009837436)   # (lat, lng)\n",
        "\n",
        "# Find nearest nodes to home and gym coordinates for path calculation\n",
        "try:\n",
        "    # Try with distance module first (newer versions)\n",
        "    home_node = ox.distance.nearest_nodes(G_final, HOME_COORDS[1], HOME_COORDS[0])\n",
        "    gym_node = ox.distance.nearest_nodes(G_final, GYM_COORDS[1], GYM_COORDS[0])\n",
        "except AttributeError:\n",
        "    # Fall back to older API\n",
        "    try:\n",
        "        home_node = ox.get_nearest_node(G_final, HOME_COORDS)\n",
        "        gym_node = ox.get_nearest_node(G_final, GYM_COORDS)\n",
        "    except AttributeError:\n",
        "        # Try another possible API version\n",
        "        home_node = ox.nearest_nodes(G_final, HOME_COORDS[1], HOME_COORDS[0])\n",
        "        gym_node = ox.nearest_nodes(G_final, GYM_COORDS[1], GYM_COORDS[0])\n",
        "\n",
        "lat_min, lat_max = bounds[1], bounds[3]\n",
        "lng_min, lng_max = bounds[0], bounds[2]\n",
        "\n",
        "lat_step = (lat_max - lat_min) / GRID_SIZE\n",
        "lng_step = (lng_max - lng_min) / GRID_SIZE\n",
        "\n",
        "def get_grid_cell(lat, lng):\n",
        "    \"\"\"Get grid cell coordinates for a point\"\"\"\n",
        "    row = min(int((lat - lat_min) / lat_step), GRID_SIZE - 1)\n",
        "    col = min(int((lng - lng_min) / lng_step), GRID_SIZE - 1)\n",
        "    return (row, col)\n",
        "\n",
        "# Build spatial index\n",
        "spatial_index = {}\n",
        "for idx, edge in edges_gdf.iterrows():\n",
        "    # Get edge bounds\n",
        "    edge_bounds = edge.geometry.bounds\n",
        "    edge_lat_min, edge_lat_max = edge_bounds[1], edge_bounds[3]\n",
        "    edge_lng_min, edge_lng_max = edge_bounds[0], edge_bounds[2]\n",
        "    \n",
        "    # Find all grid cells this edge intersects\n",
        "    start_row = max(0, int((edge_lat_min - lat_min) / lat_step))\n",
        "    end_row = min(GRID_SIZE - 1, int((edge_lat_max - lat_min) / lat_step))\n",
        "    start_col = max(0, int((edge_lng_min - lng_min) / lng_step))\n",
        "    end_col = min(GRID_SIZE - 1, int((edge_lng_max - lng_min) / lng_step))\n",
        "    \n",
        "    # Add edge to all relevant grid cells\n",
        "    for row in range(start_row, end_row + 1):\n",
        "        for col in range(start_col, end_col + 1):\n",
        "            cell_key = f\"{row},{col}\"\n",
        "            if cell_key not in spatial_index:\n",
        "                spatial_index[cell_key] = []\n",
        "            \n",
        "            # Extract geometry points efficiently\n",
        "            if hasattr(edge.geometry, 'coords'):\n",
        "                geometry_points = list(edge.geometry.coords)\n",
        "            else:\n",
        "                geometry_points = [(edge.geometry.x, edge.geometry.y)]\n",
        "            \n",
        "            edge_data = {\n",
        "                'id': f\"edge_{idx}\",\n",
        "                'geometry': [[lat, lng] for lng, lat in geometry_points],  # Convert to [lat, lng]\n",
        "                'length_meters': float(edge.get('length', 0)),\n",
        "                'street_name': str(edge.get('name', '')),\n",
        "                'highway_type': str(edge.get('highway', 'unknown')),\n",
        "                'from_node': str(edge.name[0]) if hasattr(edge, 'name') else f\"node_{idx}_start\",\n",
        "                'to_node': str(edge.name[1]) if hasattr(edge, 'name') else f\"node_{idx}_end\"\n",
        "            }\n",
        "            spatial_index[cell_key].append(edge_data)\n",
        "\n",
        "print(f\"🔍 Created spatial index with {len(spatial_index)} grid cells\")\n",
        "\n",
        "# Step 5: Create final optimized JSON structure\n",
        "export_data = {\n",
        "    'metadata': {\n",
        "        'generated_at': time.strftime('%Y-%m-%d %H:%M:%S'),\n",
        "        'total_nodes': len(nodes_gdf),\n",
        "        'total_edges': len(edges_gdf), \n",
        "        'total_length_miles': float(edges_gdf['length'].sum() / 1609.34),\n",
        "        'bounds': {\n",
        "            'north': float(lat_max),\n",
        "            'south': float(lat_min), \n",
        "            'east': float(lng_max),\n",
        "            'west': float(lng_min)\n",
        "        },\n",
        "        'grid_size': GRID_SIZE,\n",
        "        'grid_bounds': {\n",
        "            'lat_min': float(lat_min),\n",
        "            'lat_max': float(lat_max),\n",
        "            'lng_min': float(lng_min), \n",
        "            'lng_max': float(lng_max),\n",
        "            'lat_step': float(lat_step),\n",
        "            'lng_step': float(lng_step)\n",
        "        }\n",
        "    },\n",
        "    'spatial_index': spatial_index,\n",
        "    'street_types': list(street_types_to_keep)\n",
        "}\n",
        "\n",
        "# Step 6: Create a street index for future polyline matching\n",
        "print(\"🧩 Creating street index for future polyline matching...\")\n",
        "\n",
        "# Create a street index structure\n",
        "street_index = {}\n",
        "for idx, edge in edges_gdf.iterrows():\n",
        "    edge_id = f\"edge_{idx}\"\n",
        "    \n",
        "    # Get geometry and properties\n",
        "    if hasattr(edge.geometry, 'coords'):\n",
        "        coords = list(edge.geometry.coords)\n",
        "    else:\n",
        "        coords = [(edge.geometry.x, edge.geometry.y)]\n",
        "    \n",
        "    # Store edge with lat/lng format (coordinates are [lat, lng] for consistency)\n",
        "    street_index[edge_id] = {\n",
        "        'coords': [[lat, lng] for lng, lat in coords],\n",
        "        'length': float(edge.get('length', 0)),\n",
        "        'name': str(edge.get('name', 'Unnamed')),\n",
        "        'type': str(edge.get('highway', 'unknown')),\n",
        "        'from_node': str(edge.name[0]),\n",
        "        'to_node': str(edge.name[1]),\n",
        "        'geometry': edge.geometry  # Keep geometry for future spatial operations\n",
        "    }\n",
        "\n",
        "# Save the street index for later use\n",
        "print(f\"💾 Saving street index ({len(street_index)} streets)...\")\n",
        "output_dir = \"astoria_conquest_data\"\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "# Save as pickle for Python reuse (preserves geometry objects)\n",
        "with open(f\"{output_dir}/street_index.pickle\", 'wb') as f:\n",
        "    pickle.dump(street_index, f)\n",
        "\n",
        "# Save as JSON for web use (without the geometry objects)\n",
        "web_street_index = {}\n",
        "for edge_id, edge_data in street_index.items():\n",
        "    web_street_index[edge_id] = {\n",
        "        'coords': edge_data['coords'],\n",
        "        'length': edge_data['length'],\n",
        "        'name': edge_data['name'],\n",
        "        'type': edge_data['type'],\n",
        "        'from_node': edge_data['from_node'],\n",
        "        'to_node': edge_data['to_node']\n",
        "    }\n",
        "\n",
        "with open(f\"{output_dir}/street_index.json\", 'w') as f:\n",
        "    json.dump(web_street_index, f)\n",
        "\n",
        "print(f\"✅ Street index saved to {output_dir}/street_index.json and {output_dir}/street_index.pickle\")\n",
        "print(f\"   • Contains {len(street_index)} streets\")\n",
        "print(f\"   • Total network length: {sum(edge_data['length'] for edge_data in street_index.values())/1609.34:.2f} miles\")\n",
        "\n",
        "# Step 7: Create a visualization of just the street network\n",
        "print(\"🎨 Creating map visualization...\")\n",
        "\n",
        "# Set up the plot with dark background\n",
        "plt.style.use('dark_background')\n",
        "fig, ax = plt.subplots(figsize=(14, 12), dpi=150)\n",
        "ax.set_facecolor('#000000')\n",
        "fig.set_facecolor('#000000')\n",
        "\n",
        "# Plot neighborhood boundaries\n",
        "gdf_astoria.plot(ax=ax, facecolor='#1a1a1a', edgecolor='#333333', alpha=0.6)\n",
        "\n",
        "# Plot the street network\n",
        "edges_gdf.plot(ax=ax, color='#444444', linewidth=0.9, alpha=0.8)\n",
        "\n",
        "# Mark the home and gym locations\n",
        "ax.scatter(HOME_COORDS[1], HOME_COORDS[0], c='#00ff00', s=150, marker='h', \n",
        "           label='Home', zorder=10, edgecolors='white', linewidth=2)\n",
        "ax.scatter(GYM_COORDS[1], GYM_COORDS[0], c='#ff8c00', s=150, marker='s', \n",
        "           label='Gym', zorder=10, edgecolors='white', linewidth=2)\n",
        "\n",
        "# Add title and legend\n",
        "ax.set_title('Astoria Street Network Map', fontsize=20, color='white', pad=20)\n",
        "ax.legend(loc='upper right', fontsize=14, frameon=True, \n",
        "         facecolor='black', edgecolor='#444444', framealpha=0.7)\n",
        "\n",
        "# Remove axis labels and ticks for cleaner look\n",
        "ax.set_xlabel('')\n",
        "ax.set_ylabel('')\n",
        "ax.set_xticks([])\n",
        "ax.set_yticks([])\n",
        "\n",
        "# Add a text box with network statistics\n",
        "try:\n",
        "    # Try to calculate shortest path length\n",
        "    import networkx as nx  # Ensure NetworkX is imported here\n",
        "    home_gym_distance = nx.shortest_path_length(G_final, home_node, gym_node, weight='length')/1609.34\n",
        "    \n",
        "    stats_text = (\n",
        "        f\"Network Statistics:\\n\"\n",
        "        f\"• Total streets: {len(street_index)}\\n\"\n",
        "        f\"• Total length: {sum(edge_data['length'] for edge_data in street_index.values())/1609.34:.1f} miles\\n\"\n",
        "        f\"• Neighborhoods: {len(gdf_astoria)}\\n\"\n",
        "        f\"• Home to Gym distance: {home_gym_distance:.2f} miles\"\n",
        "    )\n",
        "except (nx.NetworkXNoPath, nx.NodeNotFound, NameError) as e:\n",
        "    # Handle case where no path exists or nodes aren't found\n",
        "    stats_text = (\n",
        "        f\"Network Statistics:\\n\"\n",
        "        f\"• Total streets: {len(street_index)}\\n\"\n",
        "        f\"• Total length: {sum(edge_data['length'] for edge_data in street_index.values())/1609.34:.1f} miles\\n\"\n",
        "        f\"• Neighborhoods: {len(gdf_astoria)}\\n\"\n",
        "        f\"• Home to Gym path: Not available\"\n",
        "    )\n",
        "    print(f\"Note: Could not calculate shortest path - {str(e)}\")\n",
        "\n",
        "props = dict(boxstyle='round', facecolor='black', alpha=0.7, edgecolor='#444444')\n",
        "ax.text(0.02, 0.02, stats_text, transform=ax.transAxes, fontsize=12,\n",
        "        verticalalignment='bottom', horizontalalignment='left', color='white',\n",
        "        bbox=props)\n",
        "\n",
        "# Apply tight layout\n",
        "plt.tight_layout()\n",
        "\n",
        "# Display the map\n",
        "plt.show()"
      ],
      "id": "71b180ff",
      "execution_count": null,
      "outputs": []
