    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "#| code-summary: \"Show My Run\"\n",
        "#| fig-cap: \"My First Run, Matched to the Astoria Street Network\"\n",
        "\n",
        "import polyline # You may need to run: pip install polyline\n",
        "import pickle\n",
        "import math\n",
        "from shapely.geometry import Point\n",
        "import networkx as nx\n",
        "import matplotlib.pyplot as plt\n",
        "import osmnx as ox\n",
        "from math import radians, sin, cos, sqrt, atan2\n",
        "\n",
        "# --- Distance calculation helper ---\n",
        "\n",
        "def _bearing_uv(u, v, Gref=G_final):\n",
        "    dx = Gref.nodes[v]['x'] - Gref.nodes[u]['x']\n",
        "    dy = Gref.nodes[v]['y'] - Gref.nodes[u]['y']\n",
        "    return math.atan2(dy, dx)\n",
        "\n",
        "def _angle_diff(a, b):\n",
        "    d = abs(a - b)\n",
        "    while d > math.pi:\n",
        "        d = abs(d - 2 * math.pi)\n",
        "    return d\n",
        "    \n",
        "def haversine(lat1, lon1, lat2, lon2):\n",
        "    \"\"\"Great-circle distance (meters) between two WGS84 points (lat, lon).\"\"\"\n",
        "    R = 6371000.0\n",
        "    phi1, phi2 = radians(lat1), radians(lat2)\n",
        "    dphi = radians(lat2 - lat1)\n",
        "    dlambda = radians(lon2 - lon1)\n",
        "    a = sin(dphi/2)**2 + cos(phi1) * cos(phi2) * sin(dlambda/2)**2\n",
        "    return 2 * R * atan2(sqrt(a), sqrt(1 - a))\n",
        "\n",
        "# 1. DECODE THE POLYLINE\n",
        "# Your provided polyline from a Strava run\n",
        "encoded_polyline = r\"wvvwFz|ebM@PA@G?u@Y[EIEq@m@wJoH?ESKQSk@c@[QqCyB{B{AaLqIc@e@aAm@}I{GMMKW{CmBmAgAu@g@eAcA_Ae@_Ay@IUOSk@_@e@e@QGSAs@a@eAw@IMOMOQQ]OGYSUI][[QcAy@a@Qg@a@WMi@m@KIQG]_@S[u@c@IMG_@@kARaC?YFo@?Y@MLa@JmAAc@H_AJs@FUDi@?[P}@Dq@@kAPoAB}@P{@ToBDKD]@YAQRo@@aALk@VsEJUFs@f@}BE@GI?[x@{CLs@Fk@FyBCuCFkB@KDCu@aAKSG?IGCO?m@JeAAm@Pu@AEu@iAQOW]w@{@u@oA{JqMKGIQMKm@u@_@]_@k@qA_BS]kAcBc@w@IIMEU_@[WM[q@eAYMg@e@_@c@EQICOSCOJ{AF[PuALo@@YLy@Bg@ZsBXmDDQNUdBQf@Ml@KrBUVALEpAOl@Al@Mf@C|AU~@Gr@Mb@APEd@k@DCHSPOTC`@Qx@QREp@Et@SRCLBZzAPdBJd@BRH\\PnAFdAF`@D`ACb@BhBCTGrBK^BPEVGpBDhBErABnCIjB@^EVEj@Az@O~ACf@K|@IPEZCdAKbBC`@M`BE|@Mv@IlAW|AKxBKn@Er@ITA^@\\KtAi@hEM|AOl@?RCVu@dAIRM|AMn@BPCRCPIL?RGd@I`@?RIz@Cr@CHCTCnAEb@GPGpAId@Az@CL@p@C^]rAK~@Mv@?VARA\\EXIxAMn@Ch@E\\Eh@CbAOlA@VETS|B?h@Kn@Ex@SnAOdBCf@Kr@OhBIl@UbA_@fAOTMHBTOLKl@UPa@b@o@`AQ`@o@x@_@v@MLw@`Ba@h@uCtEc@~@_@hAg@p@KVo@dA}@t@c@\\a@`@iA~@k@JGDCCIH]Fa@N{@`@m@^IB_@ZIBSSQW_@i@SQYc@a@_@Ug@KIa@SKSMIKOIEKe@WSQ_@USYi@SUYk@m@k@MQKUWOSS[a@M[u@q@cA}AcAiA]u@m@k@MSSOU]YYKSAMEGcA}@MYe@g@ISm@{@o@y@k@_AKM}@uAf@eAlBcD@IG_@DM`A}A@MTc@DCLB`@h@r@p@j@n@xAnAj@p@NVj@l@~@pBVVbAnAJPJ\\dAjATb@l@l@Zb@^b@FJX\\JTb@p@d@l@jAhANXp@t@JZ\\d@f@j@VPz@pAFNTX`@p@f@l@zAxAd@v@r@t@JXRNR`@`@j@LH`@Dr@d@v@^xAfAr@b@TRLVlA|@PPHFNNBFPDp@d@TE^_@~DkF|HuJd@i@h@]bBaA?KFGVCXDVG^Q^]^Kl@b@FNB?PJ|@z@~@`@h@`@XXZ^t@d@d@d@HBDFjAx@HHn@XZPRZd@^NTp@^`@Xx@v@XRj@VrAt@pA|@LP@LAPMd@F|@Ky@?UOKBC\"\n",
        "\n",
        "# The decoded_coords will be a list of (latitude, longitude) tuples\n",
        "decoded_coords = polyline.decode(encoded_polyline)\n",
        "print(f\"📍 Decoded polyline into {len(decoded_coords)} GPS points.\")\n",
        "\n",
        "# --- DIAGNOSTICS: CRS + bbox + raw GPS overlay ---\n",
        "print(\"CRS check:\")\n",
        "try:\n",
        "    import osmnx as _ox\n",
        "    print(\"  gdf_astoria.crs:\", gdf_astoria.crs)\n",
        "    print(\"  edges_gdf.crs  :\", edges_gdf.crs)\n",
        "    try:\n",
        "        print(\"  G_final CRS    :\", _ox.utils_graph.get_graph_crs(G_final))\n",
        "    except Exception:\n",
        "        pass\n",
        "except Exception:\n",
        "    pass\n",
        "\n",
        "# Bounds of the network (lon/lat degrees)\n",
        "minx, miny, maxx, maxy = edges_gdf.total_bounds\n",
        "print(\"Bounds [minx, miny, maxx, maxy]:\", (minx, miny, maxx, maxy))\n",
        "\n",
        "# Do the first few GPS points fall inside the network bbox?\n",
        "for i, (lat, lon) in enumerate(decoded_coords[:5], 1):\n",
        "    inside = (minx <= lon <= maxx) and (miny <= lat <= maxy)\n",
        "    print(f\"pt{i}: (lat={lat:.6f}, lon={lon:.6f}) inside_bbox={inside}\")\n",
        "\n",
        "# Plot network + raw GPS points (no map-matching) for a quick visual sanity check\n",
        "import matplotlib.pyplot as _plt\n",
        "_plt.style.use('dark_background')\n",
        "_fig, _ax = _plt.subplots(figsize=(10, 8), dpi=120)\n",
        "gdf_astoria.plot(ax=_ax, facecolor='#1a1a1a', edgecolor='#333333', alpha=0.6)\n",
        "edges_gdf.plot(ax=_ax, color='#444444', linewidth=0.9, alpha=0.8)\n",
        "_ax.scatter([p[1] for p in decoded_coords], [p[0] for p in decoded_coords], s=6, c='cyan', alpha=0.8, label='Raw GPS')\n",
        "_ax.legend(facecolor='black', edgecolor='#444', framealpha=0.7)\n",
        "_ax.set_title('Network + Raw GPS (sanity check)')\n",
        "_ax.set_xticks([]); _ax.set_yticks([])\n",
        "_plt.tight_layout(); _plt.show()\n",
        "\n",
        "# --- CLIP GPS to the network bbox to avoid far-away snaps ---\n",
        "\n",
        "decoded_clipped = [(lat, lon) for (lat, lon) in decoded_coords if (minx <= lon <= maxx) and (miny <= lat <= maxy)]\n",
        "if len(decoded_clipped) < len(decoded_coords):\n",
        "    print(f\"Clipped {len(decoded_coords) - len(decoded_clipped)} GPS points outside bbox; using {len(decoded_clipped)} points.\")\n",
        "else:\n",
        "    print(\"All GPS points are within bbox.\")\n",
        "\n",
        "# --- Improve map-matching sensitivity ---\n",
        "# Light smoothing to reduce GPS jitter (moving average window=3)\n",
        "def smooth_trace(points, w=3):\n",
        "    if w <= 1 or len(points) < w:\n",
        "        return points\n",
        "    sm = []\n",
        "    for i in range(len(points)):\n",
        "        a = max(0, i - w // 2)\n",
        "        b = min(len(points), i + w // 2 + 1)\n",
        "        lats = [p[0] for p in points[a:b]]\n",
        "        lons = [p[1] for p in points[a:b]]\n",
        "        sm.append((sum(lats) / len(lats), sum(lons) / len(lons)))\n",
        "    return sm\n",
        "\n",
        "# Parameters controlling sensitivity\n",
        "SPATIAL_CLUSTER_DIST = 32   # cluster distance for point aggregation\n",
        "\n",
        "# Apply smoothing to the clipped trace\n",
        "decoded_smooth = smooth_trace(decoded_clipped, w=3)\n",
        "\n",
        "# Apply spatial clustering to reduce redundant points\n",
        "def spatial_cluster(points, dist_threshold=SPATIAL_CLUSTER_DIST):\n",
        "    \"\"\"Group points that are within dist_threshold meters of each other.\"\"\"\n",
        "    if not points:\n",
        "        return []\n",
        "        \n",
        "    clusters = []\n",
        "    current_cluster = [points[0]]\n",
        "    \n",
        "    for i in range(1, len(points)):\n",
        "        prev_lat, prev_lon = points[i-1]\n",
        "        curr_lat, curr_lon = points[i]\n",
        "        \n",
        "        # Calculate distance between consecutive points\n",
        "        dist = haversine(prev_lat, prev_lon, curr_lat, curr_lon)\n",
        "        \n",
        "        if dist <= dist_threshold:\n",
        "            # Add to current cluster\n",
        "            current_cluster.append(points[i])\n",
        "        else:\n",
        "            # Start a new cluster\n",
        "            if current_cluster:\n",
        "                # Average the points in the cluster\n",
        "                avg_lat = sum(p[0] for p in current_cluster) / len(current_cluster)\n",
        "                avg_lon = sum(p[1] for p in current_cluster) / len(current_cluster)\n",
        "                clusters.append((avg_lat, avg_lon))\n",
        "            current_cluster = [points[i]]\n",
        "    \n",
        "    # Don't forget the last cluster\n",
        "    if current_cluster:\n",
        "        avg_lat = sum(p[0] for p in current_cluster) / len(current_cluster)\n",
        "        avg_lon = sum(p[1] for p in current_cluster) / len(current_cluster)\n",
        "        clusters.append((avg_lat, avg_lon))\n",
        "    \n",
        "    return clusters\n",
        "\n",
        "# Apply spatial clustering to reduce redundancy\n",
        "decoded_clustered = spatial_cluster(decoded_smooth)\n",
        "\n",
        "# 2. MATCH GPS POINTS TO THE STREET NETWORK (edge-based + threshold)\n",
        "# Snap to nearest *edges* first, then choose the closer endpoint node.\n",
        "edge_triplets, snap_dists = ox.distance.nearest_edges(\n",
        "    G_final,\n",
        "    X=[p[1] for p in decoded_clustered],\n",
        "    Y=[p[0] for p in decoded_clustered],\n",
        "    return_dist=True,\n",
        ")\n",
        "\n",
        "# No need to calculate GPS directions anymore (removed trajectory-aware matching)\n",
        "\n",
        "# Simplified candidate node selection - just pick the closer endpoint\n",
        "candidate_nodes = []\n",
        "\n",
        "for i, ((u, v, k), (lat, lon), d) in enumerate(zip(edge_triplets, decoded_clustered, snap_dists)):\n",
        "    if d is None:\n",
        "        continue\n",
        "        \n",
        "    # Get edge endpoints\n",
        "    u_coords = (G_final.nodes[u]['y'], G_final.nodes[u]['x'])\n",
        "    v_coords = (G_final.nodes[v]['y'], G_final.nodes[v]['x'])\n",
        "    \n",
        "    # Calculate distances to both endpoints\n",
        "    du = haversine(lat, lon, *u_coords)\n",
        "    dv = haversine(lat, lon, *v_coords)\n",
        "    \n",
        "    # Simply pick the closer node\n",
        "    candidate_nodes.append(u if du <= dv else v)\n",
        "\n",
        "# Simple de-duplication - remove consecutive duplicates\n",
        "snapped_nodes = []\n",
        "for n in candidate_nodes:\n",
        "    if not snapped_nodes or n != snapped_nodes[-1]:\n",
        "        snapped_nodes.append(n)\n",
        "\n",
        "# 3. RECONSTRUCT THE PATH\n",
        "# First, make sure we have matched nodes before proceeding\n",
        "if not snapped_nodes:\n",
        "    print(\"⚠️ Warning: No nodes matched!\")\n",
        "\n",
        "# Create a simple undirected graph for shortest path\n",
        "G_u = nx.Graph()\n",
        "for u, v, k, data in G_final.edges(keys=True, data=True):\n",
        "    # keep the shortest edge length between any parallel edges\n",
        "    w = data.get('length', 1.0)\n",
        "    if G_u.has_edge(u, v):\n",
        "        if w < G_u[u][v].get('length', float('inf')):\n",
        "            G_u[u][v]['length'] = w\n",
        "    else:\n",
        "        G_u.add_edge(u, v, length=w)\n",
        "\n",
        "full_matched_path = []\n",
        "\n",
        "for a, b in zip(snapped_nodes[:-1], snapped_nodes[1:]):\n",
        "    if a == b:\n",
        "        continue\n",
        "    \n",
        "    try:\n",
        "        # Use regular shortest path\n",
        "        seg = nx.shortest_path(G_u, a, b, weight='length')\n",
        "            \n",
        "        # Add this segment to the full path\n",
        "        if full_matched_path:\n",
        "            full_matched_path.extend(seg[1:])\n",
        "        else:\n",
        "            full_matched_path.extend(seg)\n",
        "            \n",
        "    except (nx.NetworkXNoPath, Exception) as e:\n",
        "        print(f\"No path between nodes {a} and {b}. Error: {str(e)[:100]}\")\n",
        "        # If no path exists, skip this hop\n",
        "        continue\n",
        "print(f\"✅ Matched run to a path of {len(full_matched_path)} nodes on the street graph.\")\n",
        "\n",
        "# 4. VISUALIZE THE FINAL MAP WITH THE RUN\n",
        "# This code is similar to your previous map visualization, with one new line to plot the route.\n",
        "plt.style.use('dark_background')\n",
        "fig, ax = plt.subplots(figsize=(14, 12), dpi=150)\n",
        "ax.set_facecolor('#000000')\n",
        "fig.set_facecolor('#000000')\n",
        "\n",
        "# Plot neighborhood boundaries and the base street network\n",
        "gdf_astoria.plot(ax=ax, facecolor='#1a1a1a', edgecolor='#333333', alpha=0.6)\n",
        "edges_gdf.plot(ax=ax, color='#444444', linewidth=0.9, alpha=0.8)\n",
        "\n",
        "# --- THIS IS THE NEW PART ---\n",
        "# Plot your map-matched run on top of the network (robust, no osmnx utils)!\n",
        "# --- THIS IS THE NEW PART ---\n",
        "if full_matched_path:\n",
        "    print(f\"✅ Using matched path with {len(full_matched_path)} nodes.\")\n",
        "else:\n",
        "    print(\"⚠️ No matched path available - falling back to raw GPS visualization.\")\n",
        "    # Plot raw GPS as a fallback\n",
        "    gps_x = [p[1] for p in decoded_smooth]\n",
        "    gps_y = [p[0] for p in decoded_smooth]\n",
        "    if gps_x:\n",
        "        ax.plot(gps_x, gps_y, linewidth=3, color='#00FFFF', alpha=0.9, zorder=5, linestyle='--')\n",
        "        \n",
        "if full_matched_path:\n",
        "    # Function to simplify a path (reduce unnecessary details)\n",
        "    def simplify_path(xs, ys, tolerance=1e-5):\n",
        "        \"\"\"Simplify a path using Ramer-Douglas-Peucker algorithm.\"\"\"\n",
        "        if len(xs) <= 2:\n",
        "            return xs, ys\n",
        "            \n",
        "        # Import here to avoid adding unnecessary dependency for whole notebook\n",
        "        from shapely.geometry import LineString\n",
        "        from shapely.simplify import simplify\n",
        "        \n",
        "        # Create LineString from coordinates\n",
        "        line = LineString(zip(xs, ys))\n",
        "        \n",
        "        # Simplify the line\n",
        "        simple_line = simplify(line, tolerance)\n",
        "        \n",
        "        # Extract simplified coordinates\n",
        "        simple_coords = list(simple_line.coords)\n",
        "        simple_xs = [x for x, y in simple_coords]\n",
        "        simple_ys = [y for x, y in simple_coords]\n",
        "        \n",
        "        return simple_xs, simple_ys\n",
        "        \n",
        "    # Create a continuous path instead of multiple segments\n",
        "    main_path_x = []\n",
        "    main_path_y = []\n",
        "    \n",
        "    # First, collect all valid segments\n",
        "    valid_segments = []\n",
        "    \n",
        "    for u, v in zip(full_matched_path[:-1], full_matched_path[1:]):\n",
        "        ed = G_final.get_edge_data(u, v)\n",
        "        if ed is None:\n",
        "            ed = G_final.get_edge_data(v, u)  # try reverse for one-ways\n",
        "            \n",
        "        if ed is None:\n",
        "            continue  # Skip invalid edges\n",
        "            \n",
        "        data = list(ed.values())[0]\n",
        "        if 'geometry' in data and data['geometry'] is not None:\n",
        "            coords = list(data['geometry'].coords)\n",
        "            seg_x = [x for x, y in coords]\n",
        "            seg_y = [y for x, y in coords]\n",
        "        else:\n",
        "            # straight between nodes if no geometry\n",
        "            seg_x = [G_final.nodes[u]['x'], G_final.nodes[v]['x']]\n",
        "            seg_y = [G_final.nodes[u]['y'], G_final.nodes[v]['y']]\n",
        "            \n",
        "        valid_segments.append((seg_x, seg_y))\n",
        "    \n",
        "    # Now build a single continuous path\n",
        "    if valid_segments:\n",
        "        main_path_x, main_path_y = valid_segments[0]\n",
        "        \n",
        "        for seg_x, seg_y in valid_segments[1:]:\n",
        "            # Check if this segment connects to the current path\n",
        "            if abs(main_path_x[-1] - seg_x[0]) < 1e-6 and abs(main_path_y[-1] - seg_y[0]) < 1e-6:\n",
        "                # Connected at the start - add the rest\n",
        "                main_path_x.extend(seg_x[1:])\n",
        "                main_path_y.extend(seg_y[1:])\n",
        "            elif abs(main_path_x[-1] - seg_x[-1]) < 1e-6 and abs(main_path_y[-1] - seg_y[-1]) < 1e-6:\n",
        "                # Connected at the end (reverse) - add the rest reversed\n",
        "                main_path_x.extend(seg_x[-2::-1])  # Skip the first point and reverse\n",
        "                main_path_y.extend(seg_y[-2::-1])\n",
        "            else:\n",
        "                # Not directly connected - find closest point and connect\n",
        "                continue  # Skip disconnected segments\n",
        "    \n",
        "    # Simplify the path to reduce unnecessary detail\n",
        "    if len(main_path_x) > 2:\n",
        "        try:\n",
        "            main_path_x, main_path_y = simplify_path(main_path_x, main_path_y, tolerance=1e-5)\n",
        "        except (ImportError, Exception) as e:\n",
        "            print(f\"Path simplification skipped: {str(e)}\")\n",
        "    \n",
        "    # Draw the main path\n",
        "    if len(main_path_x) >= 2:\n",
        "        ax.plot(main_path_x, main_path_y, linewidth=3, color='#00FFFF', alpha=0.9, zorder=5)\n",
        "    \n",
        "    # Ensure the same plot extent as the base network (avoid autoscale surprises)\n",
        "    xmin, ymin, xmax, ymax = edges_gdf.total_bounds\n",
        "    ax.set_xlim([xmin, xmax]); ax.set_ylim([ymin, ymax])\n",
        "# ----------------------------\n",
        "\n",
        "# Mark the home and gym locations\n",
        "ax.scatter(HOME_COORDS[1], HOME_COORDS[0], c='#00ff00', s=150, marker='h', \n",
        "           label='Home', zorder=10, edgecolors='white', linewidth=2)\n",
        "ax.scatter(GYM_COORDS[1], GYM_COORDS[0], c='#ff8c00', s=150, marker='s', \n",
        "           label='Gym', zorder=10, edgecolors='white', linewidth=2)\n",
        "\n",
        "ax.set_title('Astoria Conquest: My First Run', fontsize=20, color='white', pad=20)\n",
        "ax.legend(loc='upper right', fontsize=14, frameon=True, \n",
        "          facecolor='black', edgecolor='#444444', framealpha=0.7)\n",
        "ax.set_xlabel('')\n",
        "ax.set_ylabel('')\n",
        "ax.set_xticks([])\n",
        "ax.set_yticks([])\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
