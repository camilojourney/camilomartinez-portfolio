{
  "private": true,
  "scripts": {
    "dev": "next dev --port 3005",
    "dev:turbo": "next dev --turbopack --port 3005",
    "dev:backend": "cd backend && uv sync && uv run uvicorn app.main:app --reload --port 8005",
    "dev:all": "concurrently \"pnpm dev:backend\" \"pnpm dev\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:backend": "cd backend && uv run --extra dev pytest",
    "test:all": "pnpm test:run && pnpm test:backend",
    "lint": "eslint .",
    "generate:knowledge": "node scripts/generate-knowledge.mjs",
    "env:pull": "./scripts/sync-env.sh pull",
    "env:status": "./scripts/sync-env.sh status",
    "env:list": "./scripts/sync-env.sh list",
    "env:sync": "./scripts/sync-env.sh pull && pnpm dev",
    "map:setup": "cd backend && uv run python app/scripts/astoria/generate_base_map.py",
    "map:update": "cd backend && uv run python app/scripts/astoria/update_progress.py",
    "db:setup": "node scripts/db/setup-astoria-database.sql",
    "db:migrate": "node scripts/db/run-strava-migration.js",
    "data:load-streets": "node scripts/data/load-astoria-streets.js",
    "data:analyze-sleep": "node scripts/data/analyze-sleep-data.js",
    "data:get-workouts": "node scripts/data/get-workout-data.js",
    "test:db-schema": "node scripts/testing/check-database-schema.js",
    "test:strava": "node scripts/testing/test-strava-integration.js",
    "test:whoop": "node scripts/testing/test-token-status.js",
    "dev:whoop-cli": "node scripts/dev/whoop-cli.js",
    "check:strava": "node scripts/testing/check-strava-setup.js",
    "check:recent-data": "node scripts/testing/check-recent-data.js"
  },
